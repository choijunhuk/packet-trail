msgid "M06_E1_TITLE"
msgstr "人の失敗、ジョブの失敗"

msgid "M06_E2_FIELD"
msgstr "[制限後にも届く通知 · 現場台帳]\n引き継がれた業務番号の観察を見つけ、二つの行を比べてください。似た無関係な行を混ぜると、別事件を同じものと誤認します。\n\nREFERENCE N61\n\nFIELD DESK\nqueue:N61:accepted-once\n\nHANDOFF TRANSCRIPT\nauth:N61:staff-valid\n\nOTHER ENTRY\nreference: OTHER-N61\nobservation: unrelated service job\n"

