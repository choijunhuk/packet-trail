msgid "M07_E1_RETAINED"
msgstr "[退勤とサーバーの鍵 · 独立保管台帳]\n現場応答のコピーではなく、別の担当が保管した観察です。reference を前の業務番号と照合し、該当行だけを選んでください。\n\nREFERENCE | DESK | OBSERVATION\nS707 | retained-witness | shift:00:58:closed / session:01:03:stale-N47\nOTHER-S707 | other-job | unrelated\n"

msgid "M07_E1_TITLE"
msgstr "退勤とサーバーの鍵"

msgid "M07_E2_FIELD"
