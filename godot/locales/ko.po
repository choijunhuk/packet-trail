msgid "M16_REPLY"
msgstr "추가 읽기 범위를 증명했습니다. 민서입니다. 저는 보존 의무를 맡았던 기록 검증자였어요. 이관 뒤의 누락을 독립 확인할 감사 자료가 남았습니다. 계정의 쉬운 비밀과 서버의 권한은 따로 검증해 주세요."

msgid "M16_REPLY_SUBJECT"
msgstr "[확인] 모두에게 열린 정비 폴더"

msgid "M16_ROUTE"
msgstr "[별도 보관 담당자의 작업 메모]\n관측 원장은 현장 응답과 독립적으로 남겼습니다. 관련 업무 번호를 찾아 현재 사건의 원장과 대조하세요.\n\npermit | group | scope\nACL16 | retention | extra-read\nACL15 | staff | normal"

msgid "M16_SUBJECT"
msgstr "[야간 의뢰] 모두에게 열린 정비 폴더"

msgid "M16_TITLE"
msgstr "모두에게 열린 정비 폴더"

msgid "M17_AUDIT"
msgstr "[M17 관찰 자료]\n허구 감사 단서를 계정 범위와 연결해 보관함을 확인한다.\n현재 사건의 관찰 자료입니다. 확보 경로는 source에서 확인하고, 파일 이름보다 기록 ID·본문·출처를 검증하세요.\n\nNIGHT HANDOFF\noffline audit candidate opens only the fictional verification vault\nRetention: original retained; necessary copy only.\n"

msgid "M17_AUDIT_NAME"
msgstr "짧은 비밀의 긴 흔적 독립 보관처"

msgid "M17_BRIEF"
msgstr "실제 사람의 암호가 아닌 작은 허구 감사 자료입니다. 온라인 로그인 제한이 걸려 있어도 이미 분리된 자료에는 다른 검증이 필요해요. CredAudit의 후보와 비용 모형을 비교해 보세요.\n\n찾은 단서가 보관함의 어느 계정에 해당하는지 확인하고 필요한 자료만 읽으세요. 사전에 없었다는 사실로 안전하다고 선언할 수는 없습니다. 위임된 감사 세션도 같은 사실에 도달합니다.\n\n의뢰 범위 안의 읽기·검증 계정입니다. 자료를 읽는 권한이 결론까지 대신하지는 않습니다.\n\n[Case access]\nauditor@auditvault.packet.test / mapped-star\ndelegate@custodym17.packet.test / field-chestnut\n\n추가로 확보할 독립 근거: 온라인과 분리된 자료, 작은 사전의 한계, 보관함 계정의 범위\n[Field ledger access]\nauditor@audit-desk.packet.test / mapped-star-desk\n[Independent ledger access]\ndelegate@witness-register.packet.test / field-chestnut-desk\nRead the ledger filenames for the business references named in the job.\n"

msgid "M17_CONTEXT"
msgstr "[허구 감사 단서를 계정 범위와 연결해 보관함을 확인한다.]\n\n업무 원장에서 관련 행을 찾으세요. 비슷한 이름·시각의 다른 사건을 같은 것으로 취급하지 마세요. 아래 식별값·요청·경로는 원자료 그대로입니다.\n\nBOUNDED VERIFICATION SHEET\nbytes: 123, 98, 122, 114, 121, 58, 38, 32\noperation: XOR each byte\nkey: 23\n\nThese bytes wrap a supplied fictional audit candidate. XOR is not a password hash; this model does not implement a real password-auditing algorithm or cracking benchmark.\n"

msgid "M17_E1_FIELD"
msgstr "[온라인과 분리된 자료 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE AUD17\n\nFIELD DESK\nonline:rate-limited\n\nHANDOFF TRANSCRIPT\noffline:audit-copy:available\n\nOTHER ENTRY\nreference: OTHER-AUD17\nobservation: unrelated service job\n"

msgid "M17_E1_FINDING"
msgstr "[온라인과 분리된 자료]\n서버의 반복 로그인 제한과 이미 분리된 감사 바이트는 다른 검증 경계다.\n\n근거 업무 번호: AUD17\n현장/보관 출처와 다음 관련 원장을 함께 보존합니다."

msgid "M17_E1_RETAINED"
msgstr "[온라인과 분리된 자료 · 독립 보관 원장]\n현장 응답의 사본이 아니라 별도 담당자가 보관한 관측 행입니다. 원장의 reference를 앞서 확인한 업무 번호와 연결하고 관련 행만 고르세요.\n\nREFERENCE | DESK | OBSERVATION\nAUD17 | retained-witness | online:rate-limited / offline:audit-copy:available\nOTHER-AUD17 | other-job | unrelated\n"

msgid "M17_E1_TITLE"
msgstr "온라인과 분리된 자료"

msgid "M17_E2_FIELD"
msgstr "[작은 사전의 한계 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE AUD17-C\n\nFIELD DESK\ndictionary:small:bounded\n\nHANDOFF TRANSCRIPT\nunmatched:not-proven-safe\n\nOTHER ENTRY\nreference: OTHER-AUD17-C\nobservation: unrelated service job\n"

msgid "M17_E2_FINDING"
msgstr "[작은 사전의 한계]\n후보 미발견은 불가능의 증거가 아니며 비용 모형은 실제 장비 시간을 뜻하지 않는다.\n\n근거 업무 번호: AUD17-C\n현장/보관 출처와 다음 관련 원장을 함께 보존합니다."

msgid "M17_E2_RETAINED"
msgstr "[작은 사전의 한계 · 독립 보관 원장]\n현장 응답의 사본이 아니라 별도 담당자가 보관한 관측 행입니다. 원장의 reference를 앞서 확인한 업무 번호와 연결하고 관련 행만 고르세요.\n\nREFERENCE | DESK | OBSERVATION\nAUD17-C | retained-witness | dictionary:small:bounded / unmatched:not-proven-safe\nOTHER-AUD17-C | other-job | unrelated\n"

msgid "M17_E2_TITLE"
msgstr "작은 사전의 한계"

msgid "M17_E3_FIELD"
msgstr "[보관함 계정의 범위 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE AUD17-S\n\nFIELD DESK\nreader:verification:allowed\n\nHANDOFF TRANSCRIPT\nreader:other-accounts:denied\n\nOTHER ENTRY\nreference: OTHER-AUD17-S\nobservation: unrelated service job\n"

msgid "M17_E3_FINDING"
msgstr "[보관함 계정의 범위]\n보관함 reader 세션은 지정 검증표의 읽기만 허용한다.\n\n근거 업무 번호: AUD17-S\n현장/보관 출처와 다음 관련 원장을 함께 보존합니다."

msgid "M17_E3_RETAINED"
msgstr "[보관함 계정의 범위 · 독립 보관 원장]\n현장 응답의 사본이 아니라 별도 담당자가 보관한 관측 행입니다. 원장의 reference를 앞서 확인한 업무 번호와 연결하고 관련 행만 고르세요.\n\nREFERENCE | DESK | OBSERVATION\nAUD17-S | retained-witness | reader:verification:allowed / reader:other-accounts:denied\nOTHER-AUD17-S | other-job | unrelated\n"

msgid "M17_E3_TITLE"
msgstr "보관함 계정의 범위"

msgid "M17_EVIDENCE_A_HOST"
msgstr "현장 관측 원장"

msgid "M17_EVIDENCE_B_HOST"
msgstr "독립 보관 원장"

msgid "M17_EXPLAIN"
msgstr "허구 감사 단서를 계정 범위와 연결해 보관함을 확인한다.\n표시된 바이트와 xor 키를 대조하되 실제 암호 균열 시간으로 해석하지 마세요.\n사용한 도구가 아니라 확인된 상태와 자료의 출처가 사건의 근거입니다. 선택하지 않은 기술은 실패가 아니라 미평가로 남습니다.\n온라인 로그인 제한은 이미 복사된 검증 자료의 오프라인 추측을 막지 못합니다. 이 사건의 XOR는 주어진 허구 후보를 전달하기 위한 포장 모형이며 비밀번호 해시가 아닙니다. 실제 암호 감사 알고리즘이나 성능을 재현하지 않습니다."

msgid "M17_GOAL"
msgstr "허구 감사 단서를 계정 범위와 연결해 보관함을 확인한다.\n추가 입증: 온라인과 분리된 자료 → 작은 사전의 한계 → 보관함 계정의 범위"

msgid "M17_HINT_1"
msgstr "현재 부족한 근거와 그 업무 번호를 먼저 확인하세요. 표시된 바이트와 xor 키를 대조하되 실제 암호 균열 시간으로 해석하지 마세요."

msgid "M17_HINT_2"
msgstr "audit-desk.packet.test의 현장 원장 또는 witness-register.packet.test의 독립 원장에서 같은 업무 번호를 찾으세요. 다음 단계는 앞 자료의 출처가 확인된 뒤 열립니다."

msgid "M17_HINT_3"
msgstr "현장 원장의 두 관측을 대조하거나, 독립 원장에서 reference=업무번호로 관련 행을 좁히세요. 핵심 자료를 확보한 뒤에는 뒤에 붙은 해석·범위 자료도 확인해야 합니다."

msgid "M17_HOST_NAME"
msgstr "짧은 비밀의 긴 흔적 업무 서비스"

msgid "M17_PRINCIPLE"
msgstr "온라인 로그인 제한은 이미 복사된 검증 자료의 오프라인 추측을 막지 못합니다. 이 사건의 XOR는 주어진 허구 후보를 전달하기 위한 포장 모형이며 비밀번호 해시가 아닙니다. 실제 암호 감사 알고리즘이나 성능을 재현하지 않습니다."

msgid "M17_REPLY"
msgstr "보관함의 N47 검증표가 확인됐습니다. 권한이 남은 토큰은 현재 설정에서 사라졌지만 과거 변경 이력에는 참조가 있어요. 삭제와 폐기가 같은 일인지 확인해 주세요."

msgid "M17_REPLY_SUBJECT"
msgstr "[확인] 짧은 비밀의 긴 흔적"

msgid "M17_ROUTE"
msgstr "[별도 보관 담당자의 작업 메모]\n관측 원장은 현장 응답과 독립적으로 남겼습니다. 관련 업무 번호를 찾아 현재 사건의 원장과 대조하세요.\n\nACCESS REGISTER\nrequired group: auditors\naccount: delegate\nscope: limited evidence read\n\nInspect the actual authenticated account and its group, not a supplied account label.\n"

msgid "M17_SUBJECT"
msgstr "[야간 의뢰] 짧은 비밀의 긴 흔적"

msgid "M17_TARGET_NAME"
msgstr "M17 제한 자료 서비스"

msgid "M17_TITLE"
msgstr "짧은 비밀의 긴 흔적"

msgid "M18_AUDIT"
msgstr "[M18 관찰 자료]\n이전 설정의 토큰 출처·현재 효력·읽기 범위를 확인한다.\n현재 사건의 관찰 자료입니다. 확보 경로는 source에서 확인하고, 파일 이름보다 기록 ID·본문·출처를 검증하세요.\n\nNIGHT HANDOFF\nretired configuration reference reconstructs a still-valid scoped token\nRetention: original retained; necessary copy only.\n"

msgid "M18_AUDIT_NAME"
msgstr "지워도 남은 설정 독립 보관처"

msgid "M18_BRIEF"
msgstr "현재 설정에는 토큰이 없습니다. 그렇다고 예전 토큰이 죽었다는 뜻은 아니죠. 변경 이력과 작업 로그에 나뉜 서비스 주소·토큰 참조를 조합해 주세요.\n\n승인된 허구 토큰만 사용하고 실제 비밀은 가져오지 않습니다. 토큰이 어디에서 왔는지, 지금 무엇을 읽을 수 있는지, 그 권한이 기록과 맞는지가 필요합니다.\n\n의뢰 범위 안의 읽기·검증 계정입니다. 자료를 읽는 권한이 결론까지 대신하지는 않습니다.\n\n[Case access]\nbuilder@repository.packet.test / hidden-seam\nscheduler@custodym18.packet.test / folded-atlas\n\n추가로 확보할 독립 근거: 현재 설정과 이전 버전, 참조에서 서비스까지, 지워진 값의 효력\n[Field ledger access]\nbuilder@build-repository.packet.test / hidden-seam-desk\n[Independent ledger access]\nscheduler@job-archive.packet.test / folded-atlas-desk\nRead the ledger filenames for the business references named in the job.\n"

msgid "M18_CONTEXT"
msgstr "[이전 설정의 토큰 출처·현재 효력·읽기 범위를 확인한다.]\n\n업무 원장에서 관련 행을 찾으세요. 비슷한 이름·시각의 다른 사건을 같은 것으로 취급하지 마세요. 아래 식별값·요청·경로는 원자료 그대로입니다.\n\nBUILD HISTORY\nold setting: RETENTION_TOKEN=retention-read-N47\ncurrent setting: RETENTION_TOKEN=(removed)\njob target: retention service\n\nRemoval from a file is not server-side revocation. Verify the actual permitted read.\n"

msgid "M18_E1_FIELD"
msgstr "[현재 설정과 이전 버전 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE CFG18\n\nFIELD DESK\ncurrent:token-field:empty\n\nHANDOFF TRANSCRIPT\nhistory:retention-token:present\n\nOTHER ENTRY\nreference: OTHER-CFG18\nobservation: unrelated service job\n"

msgid "M18_E1_FINDING"
msgstr "[현재 설정과 이전 버전]\n현재 설정의 빈 토큰 칸과 이전 버전의 활성 참조는 같은 의미가 아니다.\n\n근거 업무 번호: CFG18\n현장/보관 출처와 다음 관련 원장을 함께 보존합니다."

msgid "M18_E1_RETAINED"
msgstr "[현재 설정과 이전 버전 · 독립 보관 원장]\n현장 응답의 사본이 아니라 별도 담당자가 보관한 관측 행입니다. 원장의 reference를 앞서 확인한 업무 번호와 연결하고 관련 행만 고르세요.\n\nREFERENCE | DESK | OBSERVATION\nCFG18 | retained-witness | current:token-field:empty / history:retention-token:present\nOTHER-CFG18 | other-job | unrelated\n"

msgid "M18_E1_TITLE"
msgstr "현재 설정과 이전 버전"

msgid "M18_E2_FIELD"
msgstr "[참조에서 서비스까지 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE CFG18-R\n\nFIELD DESK\nconfig:retention-read-N47\n\nHANDOFF TRANSCRIPT\njob:retention-service:N47\n\nOTHER ENTRY\nreference: OTHER-CFG18-R\nobservation: unrelated service job\n"

msgid "M18_E2_FINDING"
msgstr "[참조에서 서비스까지]\n설정 이력의 토큰 참조는 작업 로그의 retention 서비스 대상과 이어진다.\n\n근거 업무 번호: CFG18-R\n현장/보관 출처와 다음 관련 원장을 함께 보존합니다."

msgid "M18_E2_RETAINED"
msgstr "[참조에서 서비스까지 · 독립 보관 원장]\n현장 응답의 사본이 아니라 별도 담당자가 보관한 관측 행입니다. 원장의 reference를 앞서 확인한 업무 번호와 연결하고 관련 행만 고르세요.\n\nREFERENCE | DESK | OBSERVATION\nCFG18-R | retained-witness | config:retention-read-N47 / job:retention-service:N47\nOTHER-CFG18-R | other-job | unrelated\n"

msgid "M18_E2_TITLE"
msgstr "참조에서 서비스까지"

msgid "M18_E3_FIELD"
msgstr "[지워진 값의 효력 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE CFG18-S\n\nFIELD DESK\nfile:token:deleted\n\nHANDOFF TRANSCRIPT\nserver:retention-read:active\n\nOTHER ENTRY\nreference: OTHER-CFG18-S\nobservation: unrelated service job\n"

msgid "M18_E3_FINDING"
