msgid "IN2_M21_TITLE"
msgstr "포털 뒤의 봉인된 기록"

msgid "IN2_M22_AUDIT"
msgstr "[M22 관찰 자료]\n외부 서버에서 내부 관리 세션까지 주체·권한 변화를 확인한다.\n현재 사건의 관찰 자료입니다. 확보 경로는 source에서 확인하고, 파일 이름보다 기록 ID·본문·출처를 검증하세요.\n\nNIGHT HANDOFF\nmanagement record ECHO-22 links exception cohorts to retention overrides\nRetention: original retained; necessary copy only.\n"

msgid "IN2_M22_AUDIT_NAME"
msgstr "웹에서 관리망까지 독립 보관처"

msgid "IN2_M22_BRIEF"
msgstr "미리보기 서버에서 내부 관리망까지 연결되지만, 요청 주체와 권한은 중간마다 바뀝니다. 지도에 선을 긋는 대신 각 단계가 실제로 가능한지 확인해 주세요.\n\n목표 관리 세션의 ECHO-22 기록 하나만 필요합니다. 작업 로그에서 정비 중계로 들어가는 다른 길도 있습니다. 시민 서비스와 다른 계정을 건드리지 않는 쪽을 택하세요.\n\npreviewer@preview.packet.test / gray-inlet\njobreader@custodym22.packet.test / narrow-bridge\n"

msgid "IN2_M22_CONTEXT"
msgstr "[외부 서버에서 내부 관리 세션까지 주체·권한 변화를 확인한다.]\n\n업무 원장에서 관련 행을 찾으세요. 비슷한 이름·시각의 다른 사건을 같은 것으로 취급하지 마세요. 아래 식별값·요청·경로는 원자료 그대로입니다.\n\nPREVIEW WORK LOG\nrequester: preview-worker\nfinal target: https://control.packet.test/relay/entry\npublic browser: no direct internal route\n\n최종 목적지와 요청 주체의 권한은 따로 확인해야 합니다.\n"

msgid "IN2_M22_EXPLAIN"
msgstr "외부 서버에서 내부 관리 세션까지 주체·권한 변화를 확인한다.\n피벗 표식 뒤에는 별도의 내부 세션과 목표 파일이 남아 있습니다.\n사용한 도구가 아니라 확인된 상태와 자료의 출처가 사건의 근거입니다. 선택하지 않은 기술은 실패가 아니라 미평가로 남습니다."

msgid "IN2_M22_GOAL"
msgstr "외부 서버에서 내부 관리 세션까지 주체·권한 변화를 확인한다."

msgid "IN2_M22_HINT_1"
msgstr "피벗 표식 뒤에는 별도의 내부 세션과 목표 파일이 남아 있습니다."

msgid "IN2_M22_HINT_2"
msgstr "현재 actor·대상·경로와 의뢰가 요구하는 결과를 비교하세요. 같은 원장을 다시 회수할 필요는 없습니다."

msgid "IN2_M22_HINT_3"
msgstr "접근 경계 실험과 승인된 대안 중 필요한 길을 선택하세요. 힌트나 특정 도구 사용은 완료 조건이 아닙니다."

msgid "IN2_M22_HOST_NAME"
msgstr "웹에서 관리망까지 업무 서비스"

msgid "IN2_M22_PRINCIPLE"
msgstr "피벗 표식 뒤에는 별도의 내부 세션과 목표 파일이 남아 있습니다."

msgid "IN2_M22_REPLY"
msgstr "적용 대상은 장애 서버가 아니라 ‘정리할 예외’로 표시된 접수였습니다. 유지해야 할 서비스와 지켜야 할 기록이 서로 다른 정책에 묶였군요. 마지막 접근 전에 정상 업무부터 돌려놓아야 합니다."

msgid "IN2_M22_REPLY_SUBJECT"
