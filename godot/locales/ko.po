msgid "M15_HOST_NAME"
msgstr "닫혔다고 생각한 관리망 업무 서비스"

msgid "M15_PRINCIPLE"
msgstr "공용망과 중계망에서 같은 포트가 다르게 보일 수 있습니다."

msgid "M15_REPLY"
msgstr "읽기 제한 세션의 존재를 확인했습니다. 제가 승인한 것은 긴급 연결이었지 무기한 관리 경로가 아닙니다. 그 차이를 누가 메웠는지, 다음 폴더의 그룹 권한을 봐 주십시오."

msgid "M15_REPLY_SUBJECT"
msgstr "[확인] 닫혔다고 생각한 관리망"

msgid "M15_ROUTE"
msgstr "[별도 보관 담당자의 작업 메모]\n관측 원장은 현장 응답과 독립적으로 남겼습니다. 관련 업무 번호를 찾아 현재 사건의 원장과 대조하세요.\n\nACCESS REGISTER\nrequired group: auditors\naccount: networkauditor\nscope: limited evidence read\n\nInspect the actual authenticated account and its group, not a supplied account label.\n"

msgid "M15_SUBJECT"
msgstr "[야간 의뢰] 닫혔다고 생각한 관리망"

