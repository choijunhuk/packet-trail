msgid "M10_ROUTE"
msgstr "[별도 보관 담당자의 작업 메모]\n관측 원장은 현장 응답과 독립적으로 남겼습니다. 관련 업무 번호를 찾아 현재 사건의 원장과 대조하세요.\n\nDESK TRANSCRIPT\nstored:text:NOTICE10\n\nRETAINED TRANSCRIPT\nrendered:action:NOTICE10"

