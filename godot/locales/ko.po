msgid "M19_E3_FIELD"
msgstr "[본문을 본 주체 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE PK19-V\n\nFIELD DESK\nendpoint:body:visible\n\nHANDOFF TRANSCRIPT\ntransit:body:unavailable\n\nOTHER ENTRY\nreference: OTHER-PK19-V\nobservation: unrelated service job\n"

msgid "M19_E3_FINDING"
