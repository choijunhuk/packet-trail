msgid "M05_E2_FIELD"
msgstr "[사본에서 빠진 한 줄 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE C731-H\n\nFIELD DESK\noriginal:C731:exception-hold\n\nHANDOFF TRANSCRIPT\ndistributed:C731:hold-omitted\n\nOTHER ENTRY\nreference: OTHER-C731-H\nobservation: unrelated service job\n"

msgid "M05_E2_FINDING"
