msgid "M15_E2_TITLE"
msgstr "끝나지 않은 임시 허가"

msgid "M15_E3_FIELD"
msgstr "[읽기 제한의 실제 범위 · 현장 원장]\n인계된 업무 번호에 해당하는 관측을 찾아 두 행을 대조하세요. 비슷한 다른 행을 섞으면 서로 다른 사건의 결론이 됩니다.\n\nREFERENCE LAN15-S\n\nFIELD DESK\nobserver:evidence:read\n\nHANDOFF TRANSCRIPT\nobserver:accounts:no-change\n\nOTHER ENTRY\nreference: OTHER-LAN15-S\nobservation: unrelated service job\n"

msgid "M15_E3_FINDING"
msgstr "[읽기 제한의 실제 범위]\n관리 세션의 관찰자는 자료 읽기만 허용되며 다른 사용자의 권한은 바꾸지 않는다.\n\n근거 업무 번호: LAN15-S\n현장/보관 출처와 다음 관련 원장을 함께 보존합니다."

msgid "M15_E3_RETAINED"
