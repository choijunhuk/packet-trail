msgid "M18_ROUTE"
msgstr "[별도 보관 담당자의 작업 메모]\n관측 원장은 현장 응답과 독립적으로 남겼습니다. 관련 업무 번호를 찾아 현재 사건의 원장과 대조하세요.\n\ntoken | state | scope\nretention-read-N47 | active | retention-read\nretired-N46 | revoked | none"

msgid "M18_SUBJECT"
msgstr "[야간 의뢰] 지워도 남은 설정"

msgid "M18_TITLE"
