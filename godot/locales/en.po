msgstr "Enable Original Work Entrance"

msgid "DF1_D01_CONTROL_GATEWAY_OPEN"
msgstr "Enable Approved Route"

msgid "DF1_D01_CONTROL_OWNER_CHECK"
msgstr "Receipt Ownership Check"

msgid "DF1_D01_DESK_NAME"
msgstr "Keep the Door Working Desk"

msgid "DF1_D01_GATEWAY_NAME"
msgstr "Approved Work Route"

msgid "DF1_D01_GOAL"
msgstr "Refuse unrelated receipt access while preserving both citizens' and assigned staff reads."

msgid "DF1_D01_HINT_1"
msgstr "Observe legitimate work separately from the problematic requests. Observe how ownership checks or narrow delegation change the result."

msgid "DF1_D01_HINT_2"
msgstr "Hold actor, target and route fixed and change one response scope to compare results."

msgid "DF1_D01_HINT_3"
msgstr "Choose precise control of the original route or an approved alternative. Turning everything off also fails legitimate work."

msgid "DF1_D01_LAB_NAME"
msgstr "Live Work and Response Checks"

msgid "DF1_D01_LIMIT"
msgstr "Passing the observed scenarios does not establish prevention of every possible attack."

msgid "DF1_D01_PRINCIPLE"
msgstr "Observe how ownership checks or narrow delegation change the result."

msgid "DF1_D01_REPLY"
msgstr "Serin and the technician can still work; unrelated access is blocked. We have a standard for the next response. The next alert mixes legitimate citizens and repeated attempts behind one address."

msgid "DF1_D01_SENDER"
msgstr "Doyun"

msgid "DF1_D01_TITLE"
msgstr "Keep the Door Working"

