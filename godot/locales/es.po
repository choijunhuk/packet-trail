msgid "UI_TOOLKIND_POLICY_MODEL"
msgstr "Aplica un valor permitido y reevalúa objetivos y servicio. En general false permite el comportamiento vulnerable y true lo bloquea."

msgid "UI_TOOLKIND_QUERY"
msgstr "Sonda de consultas"

msgid "UI_TOOLKIND_QUERY_LIMIT"
msgstr "No reproduce un motor SQL ni su sintaxis completa. Solo trata filas virtuales, sin conectar bases reales."

msgid "UI_TOOLKIND_QUERY_MODEL"
msgstr "Imita una sintaxis reducida. Observa si la entrada queda como valor o altera condiciones como OR. Con vinculación activada se trata solo como valor."

msgid "UI_TOOLKIND_RELEASE_CASE"
msgstr "Revisión de versión y divulgación"

