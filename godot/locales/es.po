msgid "UI_TOOLKIND_RENDER_LIMIT"
msgstr "No ejecuta JavaScript real. Los efectos sobre otros usuarios solo son resultados virtuales definidos."

msgid "UI_TOOLKIND_RENDER_MODEL"
msgstr "Compara si la entrada se muestra como texto o como señal virtual. Con escape activado solo aparece como texto."

