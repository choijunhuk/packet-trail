msgid "UI_TOOLKIND_LOG_MODEL"
msgstr "Lee el registro con los permisos del terminal y compara tú hora, actor y destino."

msgid "UI_TOOLKIND_MEMORY"
msgstr "Modelo de memoria"

msgid "UI_TOOLKIND_MEMORY_LIMIT"
msgstr "No reproduce memoria, direcciones ni protecciones reales. Solo usa celdas virtuales limitadas."

msgid "UI_TOOLKIND_MEMORY_MODEL"
msgstr "Muestra un búfer fijo y celdas posteriores. Al escribir bytes hexadecimales ves qué celdas alcanza el exceso."

msgid "UI_TOOLKIND_OBSERVATION_CASE"
