msgid "UI_TOOLKIND_OBSERVATION_CASE_LIMIT"
msgstr "Compartir IP no demuestra identidad. Errores de reloj, muestreo y procedencia limitan las conclusiones; no se compara con un culpable oculto."

msgid "UI_TOOLKIND_OBSERVATION_CASE_MODEL"
msgstr "Recoge observaciones en ventanas y puntos autorizados y clasifica afirmaciones según sus copias: respaldadas, refutadas o indeterminadas."

msgid "UI_TOOLKIND_PACKET"
msgstr "Ver paquetes"

msgid "UI_TOOLKIND_PACKET_LIMIT"
msgstr "No captura redes reales. Solo modela que un observador intermedio no ve el cuerpo de un tramo cifrado."

msgid "UI_TOOLKIND_PACKET_MODEL"
msgstr "Filtra filas virtuales con campo=valor para encontrar el flujo pertinente."

msgid "UI_TOOLKIND_PATH"
