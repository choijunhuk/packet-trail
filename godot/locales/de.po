msgid "IN2_M01_FILE_SHIFT_NOTE_TXT"
msgstr "[Übergabenotiz]\nWartungskonto: maint\nVorläufige Phrase: lumen-47\nÜbergabeaufzeichnung: /vault/handoff.log\nZwischengespeicherte Kopie: https://mirror.packet.test/cache/47\nOriginale weder ändern noch löschen.\n"

msgid "IN2_M01_GOAL"
msgstr "Erhalte das Original und sichere Übergabe N47 in ~/archive."

msgid "IN2_M01_HINT_1"
msgstr "Verbinde dich mit dem öffentlichen Konto und vergleiche geschützten Ordner und öffentliche Notiz. Eine Ablehnung ist nicht erforderlich."

msgid "IN2_M01_HINT_2"
msgstr "/public/shift-note.txt nennt das Konto maint und eine separate Webcachekopie."

msgid "IN2_M01_HINT_3"
msgstr "Sichere /vault/handoff.log über die Wartung oder die Kopie unter mirror.packet.test/cache/47. public/handoff.log trägt denselben Namen, ist aber eine andere Aufzeichnung."

